   "source": [
    "def fact(n):\n",
    "    if n==0 or n==1:\n",
    "        print(\"ERROR\")\n",
    "    else:\n",
    "        print(n*fact(n-1))\n",
    "n=int(input(\"ENTER VALUE FOR FACTORIAL:-\"))\n",
    "fact(n)"
   ]
